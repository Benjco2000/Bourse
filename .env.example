# Copiez ce fichier en `.env` (à la racine du projet) puis renseignez votre clé.
# `.env` est ignoré par Git : votre clé ne sera jamais poussée sur GitHub.

# Clé API Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs/dashboard)
FMP_API_KEY=

# Optionnel : clé du fournisseur LLM choisi dans config/settings.yaml (llm.provider) pour les textes
# générés par IA (modèle économique, synthèse des actualités). Sans clé, seuls les textes sourcés sont affichés.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optionnel : dossier où sont écrites les données (bronze / silver / gold / ops)
# BOURSE_DATA_DIR=./data

# Optionnel : fichier de configuration (univers de tickers, fréquences, hypothèses de valorisation)
# BOURSE_CONFIG=./config/settings.yaml

# Optionnel : niveau de logs (DEBUG, INFO, WARNING)
# BOURSE_LOG_LEVEL=INFO
